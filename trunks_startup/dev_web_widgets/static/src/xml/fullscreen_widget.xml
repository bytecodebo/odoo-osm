<templates id="template" xml:space="preserve">
    <t t-name="FullScreenControl">


         <div class="oe_fullscreen_control">

              <button t-att-data-id="widget.controlId" type="button"
                t-att-data-res-id="widget.uniqueId" t-att-data-target-id="widget.targetId"
                class="screen-button-extend-compress">
                    <t t-set="isFullScreen" t-value="widget.isFullscreen || false"/>
                 <i t-att-class="'fa' + (isFullScreen ? ' fa-compress': ' fa-expand')"></i>
              </button>

          </div>
